# ─────────────────────────────────────────────────────────────────────────────
# Contract Review Agent — environment configuration
#
# Copy this file to `.env` and fill in real values. Every reviewer model is
# defined here so you can swap models without touching code.
# ─────────────────────────────────────────────────────────────────────────────

# === Three Reviewer Models (parallel, each with a different lens) ===
# Lens options: legal_accuracy | commercial_fairness | completeness
REVIEWER_1_MODEL=openai/kimi-k3
REVIEWER_1_LENS=legal_accuracy
REVIEWER_1_NAME="Legal Reviewer"

REVIEWER_2_MODEL=openai/qwen-3.7-plus
REVIEWER_2_LENS=commercial_fairness
REVIEWER_2_NAME="Commercial Reviewer"

REVIEWER_3_MODEL=openai/glm-5.2
REVIEWER_3_LENS=completeness
REVIEWER_3_NAME="Completeness Reviewer"

# === Quiz Generation Model (generates natural-language questions per slot) ===
QUIZ_MODEL=openai/glm-5.2

# === Drafting + Evaluation models (reused from law-bench) ===
DRAFTER_MODEL=openai/qwen-3.7-plus
EVAL_MODEL=openai/kimi-k3

# === Evaluation concurrency ===
# Max concurrent criterion judges during rubric eval. Lower (1-2) to avoid API
# rate limits; raise for speed when the endpoint allows it. Default 2.
EVAL_MAX_WORKERS=2

# === Reviewer concurrency ===
# How many reviewers run at once. The relay enforces a low CONCURRENCY cap
# (~4, shared across all consumers) - "并发请求过多（上限 4）". Keep this at 1
# (serial) for reliability; raise to 2-3 for speed if the endpoint allows.
REVIEW_CONCURRENCY=1

# === LLM retry on rate-limit ===
# call_llm retries rate-limit / concurrency / quota / transient errors with
# backoff. The shared relay (linjie.love) is often saturated ("没有可分配的
# 空闲 PAT") or enforces 20 req/min - raise retries + backoff when it's busy.
LLM_MAX_RETRIES=5
LLM_RETRY_BACKOFF=3

# === OpenAI-compatible endpoint (relay) ===
OPENAI_API_KEY=sk-replace-me
OPENAI_API_BASE=https://www.linjie.love/v1

# === Database (shared law-bench PostgreSQL) ===
DATABASE_URL=postgresql://app:CHANGEME@localhost:15432/law_bench

# === Server ===
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
