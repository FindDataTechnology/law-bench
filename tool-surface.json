{
  "schema": "mcp-tool-surface/v1",
  "server": "law-bench",
  "entry_path": "/law-bench",
  "product_line": "lex",
  "hosting": [
    "shared-instance"
  ],
  "description": "LawBench 合同智能 MCP（52 工具）：条款语料与装配、合同生成、法条引用、验证审查（commercial 面）；评测/rubric/对比/自愈流水线/语料治理（internal 面）。分级依据 design D8（adapt-legal-skills-to-facet-presets）。",
  "skills_eligible_for_packs": [
    "contract-review-cn",
    "civil-nine-step-workflow",
    "labor-arbitration-workflow",
    "personal-injury-calculator",
    "criminal-defense-workflow",
    "criminal-plea-and-nonprosecution",
    "criminal-trial-examination-outline",
    "statute-validity-check",
    "case-retrieval-report",
    "legal-concept-map",
    "litigation-drafting",
    "evidence-card-organizer",
    "labor-compensation-calculator"
  ],
