# law-bench admin-assistant CopilotKit runtime — local env template.
# Copy to .env (gitignored) and fill in. The k8s deployment injects the same
# variables via the `copilot-runtime` secret instead of a file.

# OpenAI-compatible chat endpoint. Default: the shared token-vault gateway
# (OpenRouter-compatible API — sk-or keys and "vendor/model" ids).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-or-<token-vault key>

# Chat model served by the endpoint.
COPILOT_MODEL=deepseek/deepseek-v4.1-flash

# Shared token of the dedicated law-bench-mcp-assistant instance (k8s secret
# law-bench-mcp-assistant / MCP_HTTP_TOKEN in the cluster).
COPILOT_MCP_TOKEN=<shared secret>

# Optional overrides:
# COPILOT_ENDPOINT=/copilotkit
# COPILOT_MCP_URL=http://law-bench-mcp-assistant.law-bench.svc.cluster.local/mcp
# COPILOT_TOOL_DENYLIST=clause_delete,rubric_delete,criterion_delete,prompt_delete
