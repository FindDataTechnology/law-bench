# --- Ark (Volcengine) — OpenAI-compatible endpoint ---
# Get these from your Ark console
OPENAI_API_KEY=your-ark-api-key-here
OPENAI_API_BASE=https://ark.cn-beijing.volces.com/api/plan/v3

# --- Model per role ---
# Format: openai/<model-id> because Ark is OpenAI-compatible
INTAKE_MODEL=openai/deepseek-v4-flash
DRAFTER_MODEL=openai/doubao-seed-2-0-pro
AUDITOR_MODEL=openai/glm-5.2

# --- Per-role knobs ---
# All optional, defaults shown
INTAKE_TEMPERATURE=0.2
DRAFTER_TEMPERATURE=0.3
DRAFTER_MAX_TOKENS=8000
AUDITOR_TEMPERATURE=0.1
AUDITOR_MAX_TOKENS=4000

# --- Evaluation judge (deepeval GEval, same Ark endpoint) ---
# Reuses OPENAI_API_KEY / OPENAI_API_BASE above.
# Format: openai/<model-id> (litellm prefix is stripped for the judge).
EVAL_MODEL=openai/glm-5.2
EVAL_TEMPERATURE=0.0
# Judge worker-pool size (rubric criteria scored in parallel).
# Optional, default 8, clamped to [1, 16]. The ceiling is load-bearing: the
# upstream Ark relay saturates, and under saturation a 429 must NEVER become a
# criterion FAIL (that once collapsed property_service to 0/10 via the
# self-iteration loop). Per-call 429/503 backoff (8s/16s, 3 attempts) stays
# active regardless of this value - if you see saturation, tune DOWN.
EVAL_MAX_WORKERS=8
# Legal contract text must not leave the machine.
DEEPEVAL_TELEMETRY_OPT_OUT=true

# --- PostgreSQL (relational data layer; replaces db/evaluation_rules.db) ---
database_url=postgresql://app:your-password@localhost:5432/law_bench

# --- Elasticsearch (vector store for RAG search) ---
elastic_search_host=http://localhost:9200
elastic_search_user=elastic
elastic_search_pass=your-elastic-password

# --- RustFS (S3-compatible object store; MinIO API-compatible) ---
# The app always reads the minio_*/MINIO_* names regardless of backend.
minio_host=http://localhost:9000
minio_console_host=http://localhost:9001
minio_local_host=http://localhost:9000
minio_root_user=minioadmin
minio_root_password=your-rustfs-password

# --- OpenRouter embeddings (OpenAI-compatible /embeddings) ---
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_DIMS=2048

# --- RAG search config (optional, defaults shown) ---
SEARCH_INDEX_NAME=contracts
MINIO_BUCKET=contracts
MINIO_TEMPLATES_PREFIX=templates/
MINIO_DRAFTS_PREFIX=drafts/
RAG_TOOL_ENABLED=1

# --- Auth (Logto OIDC, hybrid Cookie + APIKey) ---
# Any OIDC provider works; self-hosted Logto is the reference setup
# (https://docs.logto.io). Base URL only — no /oidc suffix.
LOGTO_ENDPOINT=https://your-logto-host
LOGTO_CLIENT_ID=your-logto-app-id
LOGTO_CLIENT_SECRET=your-logto-app-secret
# MUST exactly match a Redirect URI registered in the Logto app settings.
LOGTO_REDIRECT_URI=http://localhost:8010/auth/callback
# OIDC + API scopes requested at /authorize. The content:*/admin scopes are the
# API Resource's permission scopes — Logto returns only the subset the user's
# roles grant, and that intersection is the access token's `scope` claim the app
# authorizes on. Without them nobody is admitted under AUTH_ADMISSION_MODE=enforce.
LOGTO_SCOPES=openid profile email content:read content:write admin
# API Resource indicator (Logto Console -> API Resources). Requested as the
# authorize `resource=` param and the expected access-token `aud`; its permission
# scopes are the app's authorization vocabulary. Roles bundle these scopes.
LOGTO_API_RESOURCE=https://your-api-resource-indicator
APP_BASE_URL=http://localhost:8010
# Stable deploy secret — never auto-rotate (rotating kills every session).
AUTH_SESSION_SECRET=generate-a-stable-random-secret
# 0 = allow http cookie on localhost dev; 1 in prod (Secure requires https).
AUTH_COOKIE_SECURE=0

# --- RBAC (permission-scoped admission + enforcement) ---
# Scopes that qualify an identity to hold a workbench session (comma-separated).
# A token whose `scope` claim intersects this set is admitted at /auth/callback;
# otherwise it is denied (fail closed). Defaults to the full API Resource set.
AUTH_ADMITTED_SCOPES=content:read,content:write,admin
# enforce (default) applies the admission gate; warn logs granted scopes and
# admits — use warn for the first rollout, then flip to enforce.
AUTH_ADMISSION_MODE=enforce
